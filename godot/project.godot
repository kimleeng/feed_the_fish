config_version=5

[application]
config/name="Feed the Fish"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/main_scene="res://garden.tscn"
run/max_fps=120
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07, 0.18, 0.15, 1)

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=6

[input]
feed={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
visit_pause={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":80)]}
field_guide={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":71)]}
pellet_machine={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":77)]}
toggle_sound={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.065, 0.16, 0.135, 1)
