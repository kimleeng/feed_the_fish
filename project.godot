; Open this file in Godot 4.6 or later. Browser game remains available via npm run dev.
config_version=5

[application]
config/name="Feed the fish"
run/main_scene="res://godot/scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A quiet Tivoli-inspired pond, now in native Godot."
config/icon="res://godot/assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=960
window/size/window_width_override=1280
window/size/window_height_override=960
window/size/min_width=360
window/size/min_height=640
window/stretch/mode="disabled"
window/stretch/scale_mode="fractional"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.965, 0.953, 0.922, 1)
renderer/rendering_method.web="gl_compatibility"

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
