{
  "name": "feed-the-fish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.ts",
    "test:browser": "playwright test",
    "check:running": "node scripts/check-running-game.mjs",
    "review:art": "node scripts/review-art.mjs",
    "review:hands": "node scripts/review-hands.mjs",
    "godot": "node godot/tools/run.mjs play",
    "godot:editor": "node godot/tools/run.mjs editor",
    "godot:prepare": "node godot/tools/prepare.mjs",
    "godot:sync": "node --experimental-strip-types godot/tools/sync_browser_data.mjs",
    "godot:test": "node godot/tools/run.mjs test",
    "godot:review": "node godot/tools/run.mjs review"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
